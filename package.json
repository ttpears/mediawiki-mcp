{
  "name": "mediawiki-mcp",
  "version": "2.0.1",
  "description": "MediaWiki MCP server with multi-wiki support and REST API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mediawiki-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "start:http": "node dist/http-transport.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "mcp",
    "mediawiki",
    "model-context-protocol",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttpears/mediawiki-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ttpears/mediawiki-mcp/issues"
  },
  "homepage": "https://github.com/ttpears/mediawiki-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.9",
    "diff": "^8.0.3",
    "express": "^4.21.2",
    "form-data": "^4.0.5",
    "jose": "^6.2.3",
    "redis": "^6.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}

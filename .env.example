# Multi-wiki configuration (comma-separated Name:URL pairs)
MEDIAWIKI_WIKIS=Main:https://wiki.example.com,Dev:https://dev.wiki.example.com

# Which wiki to use when none is specified
MEDIAWIKI_DEFAULT_WIKI=Main

# Per-wiki bot password credentials
# Create at each wiki's Special:BotPasswords
# Username format: User@BotName (e.g. Admin@mcp)
MEDIAWIKI_USERNAME_MAIN=Admin@mcp
MEDIAWIKI_PASSWORD_MAIN=
MEDIAWIKI_USERNAME_DEV=Admin@mcp
MEDIAWIKI_PASSWORD_DEV=

# Server
MEDIAWIKI_MCP_PORT=8009
MEDIAWIKI_MCP_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# OAuth connector mode (claude.ai). Leave MEDIAWIKI_MCP_AUTH unset to keep the
# unauthenticated header path used by LibreChat. See the README section
# "Use as a Claude.ai Connector (OAuth)".
# ---------------------------------------------------------------------------
# MEDIAWIKI_MCP_AUTH=oauth
# Public HTTPS base URL of this server (no trailing slash)
# MEDIAWIKI_MCP_PUBLIC_URL=https://wiki-mcp.example.com
# Which registered wiki this connector serves (single-wiki)
# MEDIAWIKI_OAUTH_WIKI=Main
# Confidential OAuth 2.0 consumer registered at Special:OAuthConsumerRegistration
# MEDIAWIKI_OAUTH_CLIENT_ID=
# MEDIAWIKI_OAUTH_CLIENT_SECRET=
# Postgres for encrypted per-user token storage
# DATABASE_URL=postgres://user:pass@host:5432/mediawiki_mcp
# Base64 of 32 random bytes (openssl rand -base64 32) — encrypts stored wiki tokens
# MEDIAWIKI_MCP_ENCRYPTION_KEY=
# Signing secret for broker-issued access tokens
# MEDIAWIKI_MCP_JWT_SECRET=

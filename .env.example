# Multi-wiki configuration (comma-separated Name:URL pairs)
MEDIAWIKI_WIKIS=Sales:https://sales-wiki.example.com,Dev:https://dev-wiki.example.com,IT:https://it-wiki.example.com

# Which wiki to use when none is specified
MEDIAWIKI_DEFAULT_WIKI=Sales

# Per-wiki bot passwords (Special:BotPasswords → create a bot → use "username@botname" + the password)
# Token key format: MEDIAWIKI_API_TOKEN_<NAME> (uppercase wiki name from above)
MEDIAWIKI_API_TOKEN_SALES=your-sales-wiki-bot-password
MEDIAWIKI_API_TOKEN_DEV=your-dev-wiki-bot-password
MEDIAWIKI_API_TOKEN_IT=your-it-wiki-bot-password

# Server configuration (for Docker, set HOST=0.0.0.0)
MEDIAWIKI_MCP_PORT=8009
MEDIAWIKI_MCP_HOST=0.0.0.0

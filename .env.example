# Multi-wiki configuration (comma-separated Name:URL pairs)
MEDIAWIKI_WIKIS=Main:https://wiki.example.com,Dev:https://dev.wiki.example.com

# Which wiki to use when none is specified
MEDIAWIKI_DEFAULT_WIKI=Main

# Per-wiki bot password credentials
# Create at each wiki's Special:BotPasswords
# Username format: User@BotName (e.g. Admin@mcp)
MEDIAWIKI_USERNAME_MAIN=Admin@mcp
MEDIAWIKI_PASSWORD_MAIN=
MEDIAWIKI_USERNAME_DEV=Admin@mcp
MEDIAWIKI_PASSWORD_DEV=

# Server
MEDIAWIKI_MCP_PORT=8009
MEDIAWIKI_MCP_HOST=0.0.0.0

# ---------------------------------------------------------------------------
# OAuth connector mode (claude.ai) — Microsoft Entra gate + bot-account backend.
# Leave MEDIAWIKI_MCP_AUTH unset to keep the unauthenticated header path used by
# LibreChat. Wiki actions use the per-wiki bot creds above (attributed to the
# Entra user). See the README "Use as a Claude.ai Connector (OAuth)".
# ---------------------------------------------------------------------------
# MEDIAWIKI_MCP_AUTH=oauth
# Public HTTPS base URL of this server (no trailing slash)
# MEDIAWIKI_MCP_PUBLIC_URL=https://wiki-mcp.example.com
# Entra app (OIDC) — redirect URI <public-url>/callback must be registered
# OAUTH_TENANT_ID=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# Entra app role that grants write (create/update/delete/upload); members without it read-only
# OAUTH_WRITE_ROLE=Writer
# Shared Redis for broker session state (redis://[:password@]host:port)
# REDIS_URL=redis://:password@redis:6379
# Signing secret for broker-issued access tokens
# MEDIAWIKI_MCP_JWT_SECRET=
# Trust X-Forwarded-* behind a reverse proxy (real client IP for rate limiting)
# MEDIAWIKI_MCP_TRUST_PROXY=1
# Optional Host-header allowlist (comma-separated)
# MEDIAWIKI_MCP_ALLOWED_HOSTS=wiki-mcp.example.com
